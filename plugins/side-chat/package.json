{
  "name": "@shellraining/dsh-side-chat",
  "version": "0.1.7",
  "type": "module",
  "description": "从当前会话派生临时侧边对话，可能修改工作区文件。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.png",
    "locale"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "build": "pnpm run typecheck && node build.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "license": "MIT",
  "author": "shellRaining",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shellRaining/dsh-plugins.git",
    "directory": "plugins/side-chat"
  },
  "homepage": "https://github.com/shellRaining/dsh-plugins/tree/main/plugins/side-chat#readme",
  "bugs": "https://github.com/shellRaining/dsh-plugins/issues",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "icon": "./icon.png"
}
