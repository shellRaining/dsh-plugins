{
  "name": "@shellraining/dsh-session-auto-rename",
  "version": "0.1.1",
  "description": "根据对话内容自动命名会话，支持自定义标题格式和摘要语言。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session-title"
  ],
  "author": "shellRaining",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shellRaining/dsh-plugins.git",
    "directory": "plugins/session-auto-rename"
  },
  "homepage": "https://github.com/shellRaining/dsh-plugins/tree/main/plugins/session-auto-rename#readme",
  "bugs": "https://github.com/shellRaining/dsh-plugins/issues",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "icon": "./icon.png",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "icon.png"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "pnpm run typecheck && node build.ts && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:peers"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-brand": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-session-projection": "catalog:",
    "@deepseek-ai/dsh-session-title": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
