{
  "name": "@shellraining/dsh-vim-menu-keys",
  "version": "0.1.1",
  "type": "module",
  "description": "在 DSH 的弹出菜单和选择框里用 Ctrl-n / Ctrl-p、Ctrl-j / Ctrl-k 上下移动",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": ["lib", "cordis.patch.yml", "LICENSE", "README.md"],
  "scripts": {
    "build": "pnpm run typecheck && node build.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": { "node": ">=24.9.0", "dsh": ">=0.2.3-alpha.2 <0.3.0" },
  "devDependencies": { "typescript": "catalog:" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "license": "MIT",
  "author": "shellRaining",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shellRaining/dsh-plugins.git",
    "directory": "plugins/vim-menu-keys"
  },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "keyboard", "vim"],
  "publishConfig": { "access": "public" }
}
