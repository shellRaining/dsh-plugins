{
  "name": "@shellraining/dsh-mermaid",
  "version": "0.5.6",
  "description": "渲染 Mermaid 图表，支持切换代码和图表视图。",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "pnpm run typecheck && node build.ts"
  },
  "devDependencies": {
    "happy-dom": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "author": "shellRaining",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shellRaining/dsh-plugins.git",
    "directory": "plugins/mermaid"
  },
  "homepage": "https://github.com/shellRaining/dsh-plugins/tree/main/plugins/mermaid#readme",
  "bugs": "https://github.com/shellRaining/dsh-plugins/issues",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "mermaid": "catalog:"
  },
  "icon": "./icon.png",
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.png",
    "locale"
  ]
}
