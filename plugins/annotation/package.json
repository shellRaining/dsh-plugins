{
  "name": "@shellraining/dsh-local-annotation",
  "version": "0.2.0",
  "type": "module",
  "description": "原生高亮与就地批注，批注以输入框引用随消息发送",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "pnpm run typecheck && node build.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "license": "MIT",
  "author": "shellRaining",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shellRaining/dsh-plugins.git",
    "directory": "plugins/annotation"
  },
  "homepage": "https://github.com/shellRaining/dsh-plugins/tree/main/plugins/annotation#readme",
  "bugs": "https://github.com/shellRaining/dsh-plugins/issues",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin"
  ],
  "publishConfig": {
    "access": "public"
  }
}
