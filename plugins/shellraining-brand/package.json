{
  "name": "@shellraining/dsh-brand",
  "version": "0.1.6",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "description": "将侧栏和欢迎页的品牌标识替换为 shellRaining 品牌。",
  "license": "MIT",
  "author": "shellRaining",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shellRaining/dsh-plugins.git",
    "directory": "plugins/shellraining-brand"
  },
  "homepage": "https://github.com/shellRaining/dsh-plugins/tree/main/plugins/shellraining-brand#readme",
  "bugs": "https://github.com/shellRaining/dsh-plugins/issues",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "pnpm run typecheck && node build.ts"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/react": "catalog:"
  },
  "icon": "./icon.png",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.png",
    "locale"
  ]
}
