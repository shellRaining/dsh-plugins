{
  "compilerOptions": {
    "target": "ES2022",
    "module": "none",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": false,
    "skipLibCheck": true,
    "removeComments": false,
    "outFile": "client.js"
  },
  "include": ["src/**/*.ts"]
}
