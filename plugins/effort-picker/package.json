{
  "name": "@shellraining/dsh-effort-picker",
  "version": "0.1.0",
  "type": "module",
  "description": "用 /effort 选择思考强度，切换模型后立即弹出强度选择，全程键盘操作",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": ["lib", "cordis.patch.yml", "LICENSE", "README.md"],
  "scripts": {
    "build": "pnpm run typecheck && node build.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": { "node": ">=24.9.0", "dsh": ">=0.2.3-alpha.2 <0.3.0" },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "license": "MIT",
  "author": "shellRaining",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shellRaining/dsh-plugins.git",
    "directory": "plugins/effort-picker"
  },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "model", "reasoning"],
  "publishConfig": { "access": "public" }
}
